{
  "version": 3,
  "suite_owner": "orchestrator",
  "suite_name": "orchestrator_history_routing_regression",
  "description": "只评测带对话历史的 Query Rewrite 与 Graph 路由。三个意图各 5 条，当前标签为人工初稿。",
  "label_status": "draft",
  "target": {
    "total": 15,
    "per_intent": {
      "query_database": 5,
      "anomaly_analysis": 5,
      "direct_answer": 5
    }
  },
  "labeling_policy": {
    "query_database": "获取事实数据、统计值、明细、排名、趋势、占比，以及只问变化幅度而不问原因。",
    "anomaly_analysis": "解释指标变化原因、寻找驱动因素、贡献、归因或定位异常来源。",
    "direct_answer": "问候、助手能力、知识解释、方法建议、代码或其他与本次业务数据查询无关的问题。"
  },
  "cases": [
    {
      "id": "history_query_01",
      "category": "history_region_followup",
      "conversation_history": [
        "用户：2025年10月销售额是多少？"
      ],
      "input_state": {
        "query": "北京呢？",
        "session_id": "eval_history_query_01"
      },
      "rewritten_query_assertions": {
        "must_contain": ["2025年10月", "北京", "销售额"],
        "must_differ_from_input": true
      },
      "expected_output_state": {
        "query": "北京呢？",
        "session_id": "eval_history_query_01",
        "intent": "query_database",
        "agent_result": {
          "entered_agent": "query_database"
        }
      }
    },
    {
